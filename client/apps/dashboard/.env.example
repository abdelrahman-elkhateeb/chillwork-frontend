# Backend (fs-api) base URL. The browser always calls /api on this site;
# in dev the Vite server forwards it here, and on Vercel middleware.ts does
# (set API_PROXY_TARGET in the Vercel project's environment variables).
# Local backend: http://localhost:3000 — deployed: https://<backend>.vercel.app

API_PROXY_TARGET=
# The customer site, for the "customers sign in on the main site" links.
VITE_CUSTOMER_SITE_URL=
